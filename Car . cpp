
#include <iostream>
#include <string>
using namespace std;

struct Car {
    int carNumber;
    string ownerName;
    Car* next;
};

Car* head = NULL;

void parkCar() {
    Car* newCar = new Car;

    cout << "Enter Car Number: ";
    cin >> newCar->carNumber;

    cout << "Enter Owner Name: ";
    cin >> newCar->ownerName;

    newCar->next = NULL;

    if (head == NULL) {
        head = newCar;
    } else {
        Car* temp = head;

        while (temp->next != NULL) {
            temp = temp->next;
        }

        temp->next = newCar;
    }

    cout << "Car Parked Successfully!\n";
}

void displayCars() {
    if (head == NULL) {
        cout << "Parking is Empty!\n";
        return;
    }

    Car* temp = head;

    cout << "\n--- Parked Cars ---\n";

    while (temp != NULL) {
        cout << "Car Number: " << temp->carNumber << endl;
        cout << "Owner Name: " << temp->ownerName << endl;
        cout << "-------------------\n";

        temp = temp->next;
    }
}

void removeCar() {
    if (head == NULL) {
        cout << "Parking is Empty!\n";
        return;
    }

    int number;
    cout << "Enter Car Number to Remove: ";
    cin >> number;

    Car* temp = head;
    Car* prev = NULL;

    while (temp != NULL &&
           temp->carNumber != number) {
        prev = temp;
        temp = temp->next;
    }

    if (temp == NULL) {
        cout << "Car Not Found!\n";
        return;
    }

    if (prev == NULL) {
        head = temp->next;
    } else {
        prev->next = temp->next;
    }

    delete temp;
    cout << "Car Removed Successfully!\n";
}

int main() {
    int choice;

    do {
        cout << "\n=== CAR PARKING MANAGEMENT ===\n";
        cout << "1. Park a Car\n";
        cout << "2. Display Parked Cars\n";
        cout << "3. Remove a Car\n";
        cout << "4. Exit\n";
        cout << "Enter Your Choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                parkCar();
                break;

            case 2:
                displayCars();
                break;

            case 3:
                removeCar();
                break;

            case 4:
                cout << "Thank You!\n";
                break;

            default:
                cout << "Invalid Choice!\n";
        }

    } while (choice != 4);

    return 0;
}
